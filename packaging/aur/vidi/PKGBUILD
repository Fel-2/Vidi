# Maintainer: Fel <exwin00@proton.me>
pkgname=vidi
pkgver=0.6.4
pkgrel=1
pkgdesc="Terminal UI for YouTube, Twitch, Kick and PeerTube"
arch=('x86_64' 'aarch64')
url="https://codeberg.org/Fel/Vidi"
license=('MIT')
# vidi pins YouTube player clients that need yt-dlp >= 2026.08.19. Not a hard
# `depends` on purpose: yt-dlp-git/nightly declare an unversioned `Provides`,
# which pacman will not match against a version constraint. vidi warns at
# startup instead, and that covers non-pacman installs too.
depends=('yt-dlp' 'mpv' 'gcc-libs')
optdepends=(
  'streamlink: Twitch and Kick live stream status and playback'
  'kitty: inline thumbnail previews'
  'ghostty: inline thumbnail previews'
  'wezterm: inline thumbnail previews'
)
makedepends=('cargo')
provides=('vidi')
conflicts=('vidi-bin' 'vidi-git')
# ring ships C objects that makepkg's default LTO cannot link.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Fel-2/Vidi/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('204578215d9cbbf2cdfb81c83515974992aac288ddbdfe930303162ba9288288')

prepare() {
  cd "Vidi-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "Vidi-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "Vidi-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "Vidi-$pkgver"
  install -Dm755 target/release/vidi "$pkgdir/usr/bin/vidi"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
