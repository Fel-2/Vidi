# Maintainer: Fel <exwin00@proton.me>
pkgname=vidi
pkgver=0.3.2
pkgrel=1
pkgdesc="Terminal UI for YouTube and Twitch"
arch=('x86_64' 'aarch64')
url="https://codeberg.org/Fel/Vidi"
license=('MIT')
depends=('yt-dlp' 'mpv' 'gcc-libs')
optdepends=(
  'streamlink: Twitch live stream status and playback'
  'kitty: inline thumbnail previews'
  'ghostty: inline thumbnail previews'
  'wezterm: inline thumbnail previews'
)
makedepends=('cargo')
provides=('vidi')
conflicts=('vidi-bin' 'vidi-git')
# ring ships C objects that makepkg's default LTO cannot link.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Fel-2/Vidi/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a1d18bf856ef18b726a8ef191fc013ec4a32238e2ed7c43e982c30f9a60dd2c3')

prepare() {
  cd "Vidi-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "Vidi-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "Vidi-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "Vidi-$pkgver"
  install -Dm755 target/release/vidi "$pkgdir/usr/bin/vidi"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
