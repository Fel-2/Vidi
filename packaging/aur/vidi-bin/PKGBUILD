# Maintainer: Fel <exwin00@proton.me>
pkgname=vidi-bin
pkgver=0.3.1
pkgrel=1
pkgdesc="Terminal UI for YouTube and Twitch (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://codeberg.org/Fel/Vidi"
license=('MIT')
depends=('yt-dlp' 'mpv')
optdepends=(
  'streamlink: Twitch live stream status and playback'
  'kitty: inline thumbnail previews'
  'ghostty: inline thumbnail previews'
  'wezterm: inline thumbnail previews'
)
provides=('vidi')
conflicts=('vidi' 'vidi-git')
_url="https://github.com/Fel-2/Vidi/releases/download/v$pkgver"
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$_url/vidi-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$_url/vidi-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('411aaef2a5821e9537570a8f07d208d846f07d66fe11afda0051a7172ef0b402')
sha256sums_aarch64=('03abbbde5e6c63463d0573c47ec33161e24afc072630dceed93b8e088e26ec1a')

package() {
  local _dir="vidi-v$pkgver-$CARCH-unknown-linux-musl"
  install -Dm755 "$_dir/vidi" "$pkgdir/usr/bin/vidi"
  install -Dm644 "$_dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_dir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
