# Maintainer: Fel <exwin00@proton.me>
pkgname=vidi-bin
pkgver=0.6.5
pkgrel=1
pkgdesc="Terminal UI for YouTube, Twitch, Kick and PeerTube (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://codeberg.org/Fel/Vidi"
license=('MIT')
# vidi pins YouTube player clients that need yt-dlp >= 2026.08.19. Not a hard
# `depends` on purpose: yt-dlp-git/nightly declare an unversioned `Provides`,
# which pacman will not match against a version constraint. vidi warns at
# startup instead, and that covers non-pacman installs too.
depends=('yt-dlp' 'mpv')
optdepends=(
  'streamlink: Twitch and Kick live stream status and playback'
  'kitty: inline thumbnail previews'
  'ghostty: inline thumbnail previews'
  'wezterm: inline thumbnail previews'
)
provides=('vidi')
conflicts=('vidi' 'vidi-git')
_url="https://github.com/Fel-2/Vidi/releases/download/v$pkgver"
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$_url/vidi-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$_url/vidi-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('b36d2447c6b6a7609271e5739428fa939823ba91a2bb0b8417fb32c178d4e0dc')
sha256sums_aarch64=('750a27062bf4f868e27a38cf816df4c2dcd53e32b6bebb1c61c30ddd0a78c64f')

package() {
  local _dir="vidi-v$pkgver-$CARCH-unknown-linux-musl"
  install -Dm755 "$_dir/vidi" "$pkgdir/usr/bin/vidi"
  install -Dm644 "$_dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_dir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
